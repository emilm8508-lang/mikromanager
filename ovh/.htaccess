# MikroManager OVH central — Apache config (works on Apache 2.2 / 2.4 + PHP-FPM)

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Force HTTPS
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # Forward Authorization header (Apache + PHP-FPM strips it by default)
    RewriteCond %{HTTP:Authorization} ^(.+)$
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]
</IfModule>

# Second method to forward Authorization (different Apache configs use different ones)
<IfModule mod_setenvif.c>
    SetEnvIf Authorization "(.*)" HTTP_AUTHORIZATION=$1
</IfModule>

# Block direct access to config.php, .sql, .md files, and any leftover
# debug/diagnostic scripts (e.g. debug-db.php) — block by naming convention
# so a future temporary script doesn't need a matching .htaccess edit to be safe.
# Use both Apache 2.2 (Order/Deny) and 2.4 (Require) syntax for compatibility.
<FilesMatch "(\.(sql|md)$|^debug-.*\.php$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

<Files "config.php">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</Files>

# CORS — viewer (laptop) needs these to fetch the API cross-origin.
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Headers "Authorization, Content-Type, X-Tenant, X-Timestamp, X-Signature, X-Encrypted, X-Totp"
    Header set Access-Control-Allow-Methods "GET, POST, OPTIONS"
</IfModule>
